<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NFSeNacionalSdk.Core\NFSeNacionalSdk.Core.csproj" />
    <ProjectReference Include="..\NFSeNacionalSdk.Contracts\NFSeNacionalSdk.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schemas\1.01\*.xsd">
      <LogicalName>NFSeNacionalSdk.Serialization.Xml.Schemas.1.01.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <PackageId>NFSeNacionalSdk.Serialization.Xml</PackageId>
    <Title>NFSe Nacional SDK XML Serialization</Title>
    <Description>XML serialization, deserialization, signing, and schema validation components for NFSe Nacional SDK integrations.</Description>
  </PropertyGroup>

</Project>
